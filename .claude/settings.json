{
  "permissions": {
    "allow": [
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)",
      "Bash(git add:*)"
    ],
    "deny": [
      "Bash(git push:*)", "Bash(git reset:*)",
      "Bash(git rebase:*)", "Bash(git checkout:*)",
      "Bash(git commit --amend:*)",
      "Read(./.env)", "Read(./.env.*)"
    ]
  }
}